DATABASE_URL=postgresql://pausepath:local-development-only@db:5432/pausepath
# Your identity provider must issue RS256 JWTs with sub, iss, aud, exp and roles.
AUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
AUTH_ISSUER=https://identity.example.com/
AUTH_AUDIENCE=pausepath-api
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Dedicated pedestrian OSRM deployment; never point at the public car-routing service.
PEDESTRIAN_ROUTER_URL=
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_ENABLED=false
