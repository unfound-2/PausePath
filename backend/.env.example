DATABASE_URL=postgresql://pausepath:local-development-only@db:5432/pausepath
# Local Compose uses public. Supabase uses pausepath + extensions (see DEPLOYMENT.md).
DB_SCHEMA=public
DB_EXTENSIONS_SCHEMA=public
DB_POOL_MAX_SIZE=5
# Optional separate owner connection for migrations; use a session/direct connection.
MIGRATION_DATABASE_URL=
# Supabase: https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
AUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
AUTH_ISSUER=https://identity.example.com/
AUTH_AUDIENCE=pausepath-api
# Supabase uses app_metadata; generic providers may use top_level.
AUTH_ROLES_SOURCE=top_level
OVERPASS_URL=https://overpass-api.de/api/interpreter
PEDESTRIAN_ROUTER_URL=
# Server-side Mapbox token, with Search access. Do not commit credentials.
MAPBOX_ACCESS_TOKEN=
# Account deletion: Supabase project URL + service-role key (server only, never in the app).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional Sign in with Apple token revocation (Apple Developer key with Sign in with Apple enabled).
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=
APPLE_PRIVATE_KEY=
